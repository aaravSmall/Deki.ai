{
  "name": "deki-overlay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only backend that bridges the overlay app to a local Ollama instance. No cloud deployment.",
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "eslint": "^10.12.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1"
  }
}
